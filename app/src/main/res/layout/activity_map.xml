<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_mapa">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/btn_medieval"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Progress Bar -->
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/progress_bg"
            android:scaleType="fitXY"/>

        <ProgressBar
            android:id="@+id/pb_steps"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:progressDrawable="@drawable/progress_fill"
            android:max="1000"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_step_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0 / 1000"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Path Trace (Dotted lines between pins) -->
    <!-- Between Level 1 and 2 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_level_1"
        app:layout_constraintEnd_toStartOf="@+id/btn_level_2"
        app:layout_constraintStart_toEndOf="@+id/btn_level_1"
        app:layout_constraintTop_toBottomOf="@+id/btn_level_2"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="0.5">
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Between Level 2 and 3 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btn_level_2"
        app:layout_constraintEnd_toEndOf="@+id/btn_level_3"
        app:layout_constraintStart_toStartOf="@+id/btn_level_2"
        app:layout_constraintTop_toBottomOf="@+id/btn_level_3">
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Between Level 3 and 4 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/btn_level_3"
        app:layout_constraintEnd_toStartOf="@+id/btn_level_4"
        app:layout_constraintStart_toEndOf="@+id/btn_level_3"
        app:layout_constraintTop_toTopOf="@+id/btn_level_3">
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/path_dot" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Level Pins -->
    <!-- Level 1: Desert Area (Bottom Left) -->
    <ImageButton
        android:id="@+id/btn_level_1"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/pin_disponivel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_container"
        app:layout_constraintVertical_bias="0.85" />

    <!-- Level 2: Volcano Area (Bottom Middle) -->
    <ImageButton
        android:id="@+id/btn_level_2"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/pin_bloqueado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_container"
        app:layout_constraintVertical_bias="0.75" />

    <!-- Level 3: Forest Area (Middle) -->
    <ImageButton
        android:id="@+id/btn_level_3"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/pin_bloqueado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_container"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Level 4: Castle/Mountain Area (Top Middle) -->
    <ImageButton
        android:id="@+id/btn_level_4"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/pin_bloqueado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_container"
        app:layout_constraintVertical_bias="0.15" />

    <!-- Level 5: Dark Forest/Tower Area (Top Right) -->
    <ImageButton
        android:id="@+id/btn_level_5"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/pin_bloqueado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_container"
        app:layout_constraintVertical_bias="0.25" />

</androidx.constraintlayout.widget.ConstraintLayout>