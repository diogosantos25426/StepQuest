<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo">

    <!-- Top Profile Header - Descido para evitar sobreposição e melhorar estética -->
    <ImageButton
        android:id="@+id/btn_info"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_dialog_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_profile_portrait"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/retrato_perfil"
        app:layout_constraintBottom_toBottomOf="@+id/btn_info"
        app:layout_constraintStart_toEndOf="@+id/btn_info"
        app:layout_constraintTop_toTopOf="@+id/btn_info" />

    <LinearLayout
        android:id="@+id/ll_bars"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/iv_profile_portrait"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_profile_portrait"
        app:layout_constraintTop_toTopOf="@+id/iv_profile_portrait">

        <ProgressBar
            android:id="@+id/pb_energy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="4dp"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/progressbar"
            android:progressTint="#4CAF50" />

        <ProgressBar
            android:id="@+id/pb_xp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/progressbar"
            android:progressTint="#2196F3" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_steps"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/ll_bars"
        app:layout_constraintStart_toStartOf="@+id/ll_bars"
        app:layout_constraintTop_toBottomOf="@+id/ll_bars">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/moldurageralcombate" />

        <TextView
            android:id="@+id/tv_steps_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Passos: 1200 / Meta: 5000"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Center Hero Animation - Descido com bias para ficar mais perto do menu -->

    <!-- Bottom Navigation Grid - Ícones aumentados e com moldura de combate -->
    <ImageView
        android:id="@+id/iv_hero_walk"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="Hero Walking"
        app:layout_constraintBottom_toTopOf="@+id/gl_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_steps"
        app:layout_constraintVertical_bias="1.0" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gl_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp"
        app:columnCount="4"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Item 1: Mapa -->
        <FrameLayout
            android:id="@+id/btn_nav_map"
            android:layout_width="0dp"
            android:layout_height="90dp"
            app:layout_columnWeight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/moldurageralcombate" />
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/mapa" />
        </FrameLayout>

        <!-- Item 2: Inventário -->
        <FrameLayout
            android:id="@+id/btn_nav_inventory"
            android:layout_width="0dp"
            android:layout_height="90dp"
            app:layout_columnWeight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/moldurageralcombate" />
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/inventario" />
        </FrameLayout>

        <!-- Item 3: Missões -->
        <FrameLayout
            android:id="@+id/btn_nav_quests"
            android:layout_width="0dp"
            android:layout_height="90dp"
            app:layout_columnWeight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/moldurageralcombate" />
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/missoes" />
        </FrameLayout>

        <!-- Item 4: Estatísticas -->
        <FrameLayout
            android:id="@+id/btn_nav_stats"
            android:layout_width="0dp"
            android:layout_height="90dp"
            app:layout_columnWeight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/moldurageralcombate" />
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/estatisticas" />
        </FrameLayout>

    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>