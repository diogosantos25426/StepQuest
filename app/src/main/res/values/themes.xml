<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema Principal da App (Compatível com AppCompatActivity) -->
    <style name="Theme.StepQuest" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Cores principais -->
        <item name="colorPrimary">@color/rpg_dark_green</item>
        <item name="colorPrimaryDark">#101D14</item>
        <item name="colorAccent">#FFD700</item>

        <!-- Garantir compatibilidade com Material3 se necessário -->
        <item name="android:windowBackground">@color/rpg_dark_green</item>
    </style>

    <!-- Estilo para o Diálogo Customizado -->
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 1. Estilo para o Splash Screen do Sistema (Android 12+) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rpg_dark_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.StepQuest</item>
    </style>

</resources>