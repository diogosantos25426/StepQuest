<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema Principal da App -->
    <style name="Theme.StepQuest" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rpg_dark_green</item>
        <item name="colorPrimaryDark">#101D14</item>
        <item name="colorAccent">#FFD700</item>
        <item name="android:windowBackground">@color/rpg_dark_green</item>
    </style>

    <!-- Estilo para o Diálogo Customizado -->
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Estilo para o Splash Screen API -->
    <!-- Como a API só aceita cores, usamos o fundo verde aqui e o ícone transparente -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rpg_dark_green</item>
        <!-- Usamos um ícone vazio para não aparecer nada por cima do background da activity -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.StepQuest</item>
    </style>

</resources>